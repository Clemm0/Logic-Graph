{
  "name": "logic-graph-workspace",
  "private": true,
  "version": "0.3.0",
  "description": "Logic Graph for Obsidian: circuit diagrams, truth tables, Karnaugh maps and more from a plain-text code block.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node scripts/test.mjs",
    "lint": "eslint packages",
    "check": "npm run lint && npm test && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.test-build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
